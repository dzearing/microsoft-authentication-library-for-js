{
    "name": "@mini-msal/react",
    "version": "0.0.0",
    "private": true,
    "description": "React bindings for @mini-msal/browser, mirroring the @azure/msal-react surface (prototype)",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "mini-msal-src": "./src/index.tsx",
            "default": "./dist/index.js"
        }
    },
    "dependencies": {
        "@mini-msal/browser": "*"
    },
    "peerDependencies": {
        "react": ">=18"
    }
}
